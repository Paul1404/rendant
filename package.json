{
  "name": "rendant",
  "version": "1.55.6",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "bun": ">=1.0"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "overrides": {
    "js-yaml": "^5.5.0",
    "shell-quote": "^1.12.0",
    "exceljs>uuid": "11.1.1",
    "archiver-utils>glob": "14.0.3",
    "exceljs>unzipper": "0.12.5",
    "readdir-glob>minimatch": "11.0.3",
    "@esbuild-kit/core-utils>esbuild": "0.28.2"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "sandbox": "bun scripts/sandbox.ts",
    "sandbox:down": "bun scripts/sandbox-down.ts",
    "build": "vite build",
    "start": "bun --smol .output/server/index.mjs",
    "generate-routes": "tsr generate",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:migrate:prod": "bun run src/server/db/migrate.ts",
    "auth:generate": "bunx @better-auth/cli generate --config src/server/auth.ts --output src/server/db/auth-schema.ts",
    "icons": "bun run scripts/generate-icons.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@orpc/client": "^1.16.1",
    "@orpc/server": "^1.16.1",
    "@orpc/tanstack-query": "^1.16.1",
    "@react-pdf/renderer": "4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/query-core": "^5.104.5",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.4",
    "@tanstack/react-table": "9.3.1",
    "@valibot/to-json-schema": "1.8.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "drizzle-orm": "^0.45.4",
    "drizzle-valibot": "^0.4.2",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.2",
    "jszip": "3.10.2",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "nitro": "npm:nitro-nightly@3.0.1-20261023-052727-7e9a0481",
    "nodemailer": "10.2.1",
    "pg": "^8.23.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "^1.168.48",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "fontkit": "^2.0.4",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
