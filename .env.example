# Database connection (Railway Postgres-Plugin liefert das automatisch)
DATABASE_URL=postgres://user:pass@host:5432/svufo

# Mind. 32 zufaellige Bytes (z.B. openssl rand -hex 32)
JWT_SECRET=

# Klartext-Passwort fuer den Admin-Login. Wird beim Start einmal mit bcrypt gehasht und im Speicher gehalten.
ADMIN_PASSWORD=

# Tigris S3 (Railway Tigris-Plugin liefert AWS_*-Variablen automatisch)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT_URL_S3=

# Bucket-Name muss manuell im Tigris-Dashboard angelegt werden
S3_BUCKET_NAME=
