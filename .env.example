# Database (Railway Postgres plugin injects this automatically)
DATABASE_URL=postgres://user:pass@host:5432/rendant
# Fail stalled connection attempts and queries instead of exhausting the pool.
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000

# better-auth
# Min. 32 random bytes, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Public base URL of the deployment (used for cookies, redirects, trusted origins)
BETTER_AUTH_URL=https://rendant.example.de
# Optional comma-separated aliases that may also submit authenticated requests.
AUTH_TRUSTED_ORIGINS=

# Remote MCP access for Codex and other trusted assistants.
# Generate at least 32 random bytes, e.g. `openssl rand -hex 32`.
MCP_BEARER_TOKEN=
# readonly exposes analysis tools only; admin also exposes audited mutations.
MCP_ACCESS_MODE=readonly
MCP_ACTOR_NAME=Codex MCP
MCP_ACTOR_EMAIL=codex@rendant.local

# Admin seed (applied once on first deploy by db:migrate:prod)
ADMIN_EMAIL=admin@example.de
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# DATEV Upload Mail is configured in-app under Einstellungen > DATEV;
# it uses the existing in-app SMTP credentials and needs no environment secret.

# S3 / Tigris (Railway bucket plugin injects the AWS_* values automatically)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT_URL_S3=
S3_BUCKET_NAME=

# E-Mail notifications: SMTP host, port, security, credentials and recipients
# are configured in-app under Einstellungen > E-Mail-Benachrichtigungen and
# stored in the database. The SMTP password is encrypted at rest with a key
# derived from BETTER_AUTH_SECRET, so no extra env var is required. The FYI mail
# links back to BETTER_AUTH_URL.

# Club name (optional fallback). The club this instance runs for is normally
# set in-app under Einstellungen > Verein (stored in the database). This env var
# is only used as the initial fallback when nothing is configured yet.
VEREINSNAME=

# SumUp: the API key for reading card revenue is configured in-app under
# Einstellungen > Kartenzahlung ueber SumUp and stored encrypted (same key
# derivation as the SMTP password). No env var is required.
