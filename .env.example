# Database (Railway Postgres plugin injects this automatically)
DATABASE_URL=postgres://user:pass@host:5432/svufo

# better-auth
# Min. 32 random bytes, e.g. `openssl rand -hex 32`
BETTER_AUTH_SECRET=
# Public base URL of the deployment (used for cookies, redirects, trusted origins)
BETTER_AUTH_URL=https://svufo.example.de
APP_URL=https://svufo.example.de

# Admin seed (applied once on first deploy by db:migrate:prod)
ADMIN_EMAIL=admin@example.de
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# S3 / Tigris (Railway bucket plugin injects the AWS_* values automatically)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_ENDPOINT_URL_S3=
S3_BUCKET_NAME=

# Branding (optional). Without these the app uses a neutral name and logo.
# Changes take effect on restart, no rebuild needed.
VEREINSNAME=
LOGO_URL=
